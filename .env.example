# Public Supabase URL and anon/publishable key. These are safe for browser use
# only when RLS and database grants are configured correctly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
BOOKING_RATE_LIMIT_URL=
BOOKING_RATE_LIMIT_TOKEN=

# Optional platform bootstrap; configure via a secure server-side process.
PLATFORM_ADMIN_EMAILS=
